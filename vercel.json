{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "services": {
    "app": {
      "root": ".",
      "framework": null,
      "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm install --include=dev --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "node ./build.js --target=web && node ./scripts/prepare_vercel.js",
      "devCommand": "node ./build.js --target=web --serve",
      "outputDirectory": "_site"
    },
    "3d-to-worldedit": {
      "root": "workbench_tools/3d-to-worldedit",
      "framework": null,
      "buildCommand": "npm run build",
      "devCommand": "npm run dev",
      "outputDirectory": "dist"
    },
    "brush_metadata_editor": {
      "root": "workbench_tools/brush_metadata_editor",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npx vite build --base=./",
      "outputDirectory": "dist"
    },
    "luanti-skin-studio": {
      "root": "workbench_tools/luanti-skin-studio",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npx vite build --base=./",
      "outputDirectory": "dist"
    },
    "metadata": {
      "root": "workbench_tools/metadata",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npx vite build --base=./",
      "outputDirectory": "dist"
    },
    "microcontroller-emulator": {
      "root": "workbench_tools/microcontroller-emulator",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npx vite build --base=./",
      "outputDirectory": "dist"
    },
    "nametag": {
      "root": "workbench_tools/nametag",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npx vite build --base=./",
      "outputDirectory": "dist"
    },
    "pixel-art-generator": {
      "root": "workbench_tools/pixel-art-generator",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
      "buildCommand": "npx vite build --base=./",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/llmsfull.txt",
      "destination": "/llms-full.txt"
    },
    {
      "source": "/lllms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/lllmsfull.txt",
      "destination": "/llms-full.txt"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(robots|llms|llms-full|llmsfull|lllms|lllmsfull)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/workbench_tools/:tool/dist/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/workbench_tools/:tool/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/workbench_tools/nametag/data/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(assets|workbench_assets|icons|font|content)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(css|themes|keymaps|lang|lib)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
